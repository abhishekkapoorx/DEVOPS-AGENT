# Copy to .env for docker compose, then replace the example secret.
# Legacy optional integrations remain available to existing deployments.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=
DATABASE_URL=postgresql://devops:devops@postgres:5432/devops_agent
DEVOPS_AGENT_ACCESS_TOKEN_SECRET=replace-with-a-random-32-character-minimum-secret
DEVOPS_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Local Compose uses HTTP only on its private tool-service network; other remote URLs require HTTPS.
DEVOPS_AGENT_TOOL_SERVICE_URL=http://tool-service:8001
# local enables PostgreSQL-backed email/password accounts in the browser approval flow.
# development is a mock identity for disposable demos only.
DEVOPS_AGENT_AUTH_MODE=local
DEVOPS_AGENT_DEVELOPMENT_USER_ID=developer
# echo makes the smoke test deterministic. Use langgraph with a provider key for a real model.
DEVOPS_AGENT_RUNTIME=echo
DEVOPS_AGENT_MODEL_PROVIDER=openai
DEVOPS_AGENT_MODEL_NAME=gpt-4o-mini
DEVOPS_AGENT_TOOL_SCOPES=git:read
# Comma-separated, container-visible repository allowlist. The example mounts this repo.
DEVOPS_AGENT_TOOL_REPOSITORIES=workspace=/workspace
