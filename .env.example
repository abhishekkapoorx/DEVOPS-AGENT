# Copy to .env for docker compose, then replace the example secret.
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
DATABASE_URL=postgresql://devops:devops@postgres:5432/devops_agent
DEVOPS_AGENT_ACCESS_TOKEN_SECRET=replace-with-a-random-32-character-minimum-secret
DEVOPS_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:8000
# local enables PostgreSQL-backed email/password accounts in the browser approval flow.
# development is a mock identity for disposable demos only.
DEVOPS_AGENT_AUTH_MODE=local
DEVOPS_AGENT_DEVELOPMENT_USER_ID=developer
# Select a model provider and provide its API key. Ollama runs locally and needs no provider key.
DEVOPS_AGENT_MODEL_PROVIDER=openai
DEVOPS_AGENT_MODEL_NAME=gpt-4o-mini
DEVOPS_AGENT_ENABLE_MCP_AGENTS=false
